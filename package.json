{
  "name": "@jamiojala/evalrail",
  "version": "0.2.0",
  "description": "Local-first prompt testing and evaluation framework for TypeScript teams.",
  "license": "MIT",
  "author": "Jami Ojala",
  "homepage": "https://github.com/jamiojala/evalrail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamiojala/evalrail.git"
  },
  "bugs": {
    "url": "https://github.com/jamiojala/evalrail/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "audit:ci": "pnpm audit --audit-level moderate",
    "build": "tsup",
    "check": "pnpm typecheck && pnpm test",
    "package:check": "node scripts/package-check.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check && pnpm audit:ci && pnpm package:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "example:basic": "tsx examples/basic.ts",
    "example:compare": "tsx examples/provider-compare.ts",
    "example:openai": "tsx examples/openai.ts"
  },
  "keywords": [
    "prompt-testing",
    "evaluation",
    "llm",
    "regression-testing",
    "typescript",
    "openai-compatible"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.20.1",
    "dotenv": "^17.4.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@3.14.2": "3.15.1",
      "js-yaml@4.1.1": "4.3.1",
      "nanoid@3.3.11": "3.3.18",
      "postcss@8.5.8": "8.5.26",
      "vite@7.3.1": "7.3.6"
    }
  }
}
